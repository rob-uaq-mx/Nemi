/*----------------------------------------------------------------------
   WinNemi.rc -- resource script (menus, accelerators, dialogs), in
   Spanish. Modernized/translated from popedit/POPPAD.RC; adds the new
   "Ejecutar" menu (F5). #pragma code_page(65001) lets the accented
   Spanish text below be written directly as UTF-8 source.
  ----------------------------------------------------------------------*/

#include <windows.h>
#include "WinNemi.h"

#pragma code_page(65001)

WinNemi ICON "WinNemi.ico"

// Tira de 9 íconos de 16x16 (4bpp, 16 colores) para la barra de herramientas
// estándar -- generada por devtools/ascii_to_bmp.py a partir de
// devtools/art/toolbar_std.art.txt (ver devtools/README.md por el orden de
// los íconos). La barra de símbolos no usa bitmap: se dibuja en tiempo de
// ejecución (WinNemiSymbols.cpp).
WinNemiToolbarStd BITMAP "toolbar_std.bmp"

WinNemi MENU
     {
     POPUP "&Archivo"
          {
          MENUITEM "&Nuevo\tCtrl+N",          IDM_NEW
          MENUITEM "&Abrir...\tCtrl+O",       IDM_OPEN
          MENUITEM "&Guardar\tCtrl+S",        IDM_SAVE
          MENUITEM "Guardar &como...",        IDM_SAVEAS
          MENUITEM SEPARATOR
          MENUITEM "&Imprimir...\tCtrl+P",    IDM_PRINT
          MENUITEM SEPARATOR
          MENUITEM "&Salir",                  IDM_EXIT
          }
     POPUP "&Editar"
          {
          MENUITEM "&Deshacer\tCtrl+Z",       IDM_UNDO
          MENUITEM SEPARATOR
          MENUITEM "Cor&tar\tCtrl+X",         IDM_CUT
          MENUITEM "&Copiar\tCtrl+C",         IDM_COPY
          MENUITEM "&Pegar\tCtrl+V",          IDM_PASTE
          MENUITEM "&Eliminar\tSupr",         IDM_CLEAR
          MENUITEM SEPARATOR
          MENUITEM "Seleccionar &todo",       IDM_SELALL
          }
     POPUP "&Buscar"
          {
          MENUITEM "&Buscar...\tCtrl+F",      IDM_FIND
          MENUITEM "Buscar &siguiente\tF3",   IDM_NEXT
          MENUITEM "&Reemplazar...\tCtrl+R",  IDM_REPLACE
          }
     POPUP "F&ormato"
          {
          MENUITEM "&Fuente...",              IDM_FONT
          }
     POPUP "&Ejecutar"
          {
          MENUITEM "&Ejecutar archivo\tF5",           IDM_RUN
          MENUITEM "&Reiniciar sesión\tCtrl+Shift+F5", IDM_RESET_SESSION
          MENUITEM SEPARATOR
          MENUITEM "&Rutas de inclusión...",           IDM_INCLUDE_PATHS
          }
     POPUP "Ay&uda"
          {
          MENUITEM "&Ayuda",                  IDM_HELP
          MENUITEM "&Acerca de WinNemi...",   IDM_ABOUT
          }
     }

WinNemi ACCELERATORS
     {
     "^N",        IDM_NEW
     "^O",        IDM_OPEN
     "^S",        IDM_SAVE
     "^P",        IDM_PRINT
     VK_F5,       IDM_RUN,   VIRTKEY
     VK_F5,       IDM_RESET_SESSION, VIRTKEY, CONTROL, SHIFT
     "^Z",        IDM_UNDO
     VK_BACK,     IDM_UNDO,  VIRTKEY, ALT
     "^X",        IDM_CUT
     VK_DELETE,   IDM_CUT,   VIRTKEY, SHIFT
     "^C",        IDM_COPY
     VK_INSERT,   IDM_COPY,  VIRTKEY, CONTROL
     "^V",        IDM_PASTE
     VK_INSERT,   IDM_PASTE, VIRTKEY, SHIFT
     VK_DELETE,   IDM_CLEAR, VIRTKEY
     "^F",        IDM_FIND
     VK_F3,       IDM_NEXT,  VIRTKEY
     "^R",        IDM_REPLACE
     VK_F1,       IDM_HELP,  VIRTKEY
     }

AboutBox DIALOG  20, 20, 160, 90
     STYLE WS_POPUP | WS_DLGFRAME
     {
     CTEXT "WinNemi",                                  -1,   0, 12, 160,  8
     ICON  "WinNemi",                                  -1,   8,  8,   0,  0
     CTEXT "Editor y consola para archivos Nemi",      -1,   0, 30, 160,  8
     CTEXT "Licenciatura en Matemáticas Aplicadas", -1, 0, 42, 160,  8
     DEFPUSHBUTTON "Aceptar",                        IDOK,  64, 68,  32, 14, WS_GROUP
     }

PrintDlgBox DIALOG 20, 20, 100, 76
     STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
     CAPTION "WinNemi"
     {
     CTEXT "Enviando",                       -1,  0, 10, 100,  8
     CTEXT "",                       IDD_FNAME,  0, 20, 100,  8
     CTEXT "a la cola de impresión.",        -1,  0, 30, 100,  8
     DEFPUSHBUTTON  "Cancelar",       IDCANCEL, 34, 50,  32, 14, WS_GROUP
     }

// Rutas extra donde buscar "incluye" cuando el archivo no está junto al que
// lo incluye (ver WinNemiState.h/WinNemiIncludeDlg.cpp). La carpeta bibcom/
// junto al .exe se busca aparte, sin necesidad de estar en esta lista.
IncludesDlg DIALOG 20, 20, 220, 150
     STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
     CAPTION "Rutas de inclusión"
     FONT 8, "MS Shell Dlg"
     {
     LTEXT   "Carpetas adicionales donde buscar los archivos de ""incluye"" (después de la carpeta del propio archivo):",
                                              -1,       8,   8, 204, 24
     LISTBOX IDD_INCLUDES_LIST,               8,  34, 204,  70, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
     PUSHBUTTON "&Agregar carpeta...",        IDD_INCLUDES_ADD,    8, 108,  90, 14
     PUSHBUTTON "&Quitar",                    IDD_INCLUDES_REMOVE, 102, 108, 50, 14
     DEFPUSHBUTTON "Aceptar",                 IDOK,     100, 128,  50, 14, WS_GROUP
     PUSHBUTTON "Cancelar",                   IDCANCEL, 156, 128,  56, 14
     }
